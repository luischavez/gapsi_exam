{
  "info": {
    "name": "Issue Tracker API",
    "description": "Run `Auth > Login` first, it saves the token used by every other request.\n\nChange `baseUrl` to point to another environment (local is `http://localhost:9900`).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9900"
    },
    {
      "key": "username",
      "value": "user1"
    },
    {
      "key": "password",
      "value": "demo_user1pass"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "issueId",
      "value": ""
    },
    {
      "key": "nextCursor",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Returns a JWT and stores it in the `token` variable, the rest of the requests use it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns a bearer token', () => {",
                  "  pm.expect(body.access_token).to.be.a('string');",
                  "  pm.expect(body.token_type).to.eql('bearer');",
                  "});",
                  "pm.collectionVariables.set('token', body.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/user",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "user"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('is the logged in user', () => {",
                  "  pm.expect(pm.response.json().username).to.eql(pm.collectionVariables.get('username'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Issues",
      "item": [
        {
          "name": "Create issue",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/issues",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test issue from Postman\",\n  \"description\": \"Lorem ipsum dolor sit amet.\",\n  \"priority\": \"high\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Priority: `high`, `medium` or `low`. Every new issue starts as `open`. Stores the new id in `issueId`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const issue = pm.response.json();",
                  "pm.test('starts as open', () => pm.expect(issue.status).to.eql('open'));",
                  "pm.collectionVariables.set('issueId', issue.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List issues",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/issues?limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                },
                {
                  "key": "status",
                  "value": "open",
                  "disabled": true,
                  "description": "open, in_progress, done"
                },
                {
                  "key": "priority",
                  "value": "high",
                  "disabled": true,
                  "description": "high, medium, low"
                }
              ]
            },
            "description": "Newest first. Stores `next_cursor` in `nextCursor` for the next page request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test('returns a page', () => {",
                  "  pm.expect(page.items).to.be.an('array');",
                  "  pm.expect(page).to.have.property('next_cursor');",
                  "});",
                  "pm.collectionVariables.set('nextCursor', page.next_cursor ?? '');"
                ]
              }
            }
          ]
        },
        {
          "name": "List issues - next page",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/issues?limit=5&cursor={{nextCursor}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                },
                {
                  "key": "cursor",
                  "value": "{{nextCursor}}"
                }
              ]
            },
            "description": "Run `List issues` first. If there was no next page the cursor is empty and the API answers 422."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('nextCursor')) {",
                  "  pm.test('no next page, skipped', () => pm.response.to.have.status(422));",
                  "  return;",
                  "}",
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns a page', () => pm.expect(pm.response.json().items).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List issues - by status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/issues?status=open",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "open"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('only open issues', () => {",
                  "  pm.response.json().items.forEach((issue) => pm.expect(issue.status).to.eql('open'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List issues - by status and priority",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/issues?status=open&priority=high",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "open"
                },
                {
                  "key": "priority",
                  "value": "high"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('only open and high issues', () => {",
                  "  pm.response.json().items.forEach((issue) => {",
                  "    pm.expect(issue.status).to.eql('open');",
                  "    pm.expect(issue.priority).to.eql('high');",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/issues/{{issueId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues",
                "{{issueId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"in_progress\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Status: `open`, `in_progress` or `done`. Uses the issue made by `Create issue`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status changed', () => pm.expect(pm.response.json().status).to.eql('in_progress'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update priority",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/issues/{{issueId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues",
                "{{issueId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priority\": \"low\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('priority changed', () => pm.expect(pm.response.json().priority).to.eql('low'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/issues/summary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues",
                "summary"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const summary = pm.response.json();",
                  "pm.test('total matches the sum by status', () => {",
                  "  const sum = Object.values(summary.by_status).reduce((a, b) => a + b, 0);",
                  "  pm.expect(summary.total).to.eql(sum);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Errors",
      "item": [
        {
          "name": "Login - wrong password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"wrong\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Issues - without token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/issues",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create issue - invalid data",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/issues",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"   \",\n  \"description\": \"Lorem ipsum\",\n  \"priority\": \"urgent\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 422', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update issue - not found",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/issues/does-not-exist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues",
                "does-not-exist"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"done\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update issue - empty body",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/issues/{{issueId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues",
                "{{issueId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 422', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "List issues - invalid filter",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/issues?status=closed",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "issues"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "closed"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 422', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
